// Makes the hand-written C header importable from Swift as `import CMilkyFFI`,
// and tells the linker to pull in libmilky_ffi.a.
module CMilkyFFI {
    header "include/milky.h"
    link "milky_ffi"
    // libmilky_ffi.a asks LaunchServices for app display names through
    // CoreFoundation, so every consumer of the archive must link it.
    link framework "CoreFoundation"
    // Settings discovery asks IOKit whether this Mac has a battery
    // ("Battery" vs "Energy" pane name).
    link framework "IOKit"
    // The live file index follows file changes through FSEvents, which lives
    // in CoreServices.
    link framework "CoreServices"
    // Document search extracts text with Apple's engines: PDFKit for PDFs,
    // AppKit's document readers for Word and RTF (through Foundation and
    // the Objective-C runtime).
    link framework "PDFKit"
    link framework "CoreGraphics"
    link framework "AppKit"
    link framework "Foundation"
    link "objc"
    export *
}